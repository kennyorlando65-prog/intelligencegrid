# IntelligenceGrid - all data sources are free and require NO API keys.
# These are tuning knobs only. Copy to .env.local for local development.

# --- Collection windows ---
IG_NEWS_LOOKBACK_HOURS=72
IG_REFRESH_TTL_SECONDS=900
IG_HTTP_TIMEOUT_SECONDS=25
IG_HTTP_MAX_RETRIES=3

# --- Upstream politeness (requests per minute, per host) ---
IG_GDELT_RPM=12
IG_OPENSKY_RPM=20
IG_NVD_RPM=10

# --- Module toggles (comma separated, empty = all enabled) ---
IG_ENABLED_SOURCES=

# --- Optional: OpenSky anonymous access works without credentials.
# Registering a free account raises the rate limit. Leave blank to stay anonymous.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
